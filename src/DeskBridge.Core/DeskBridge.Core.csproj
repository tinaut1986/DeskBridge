<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- One dictionary per interface language: { "English text": "Translation" }. -->
    <EmbeddedResource Include="Locales\*.json" LogicalName="DeskBridge.Locales.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>

</Project>
