<Window x:Class="DeskBridge.Gui.Updates.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DeskBridge.Gui.Localization"
        Title="{l:T 'DeskBridge update'}" Width="560" Height="540" MinWidth="420" MinHeight="200"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource CardBackground}" FontFamily="Segoe UI" FontSize="13">
    <!-- Own background: the Fluent window itself is transparent (Mica). -->
    <DockPanel Background="{DynamicResource CardBackground}">
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBackground}" Padding="20,18,20,14">
            <DockPanel>
                <Border x:Name="IconBox" Width="44" Height="44" CornerRadius="12" Background="{DynamicResource ChipBackground}" Margin="0,0,14,0" VerticalAlignment="Top">
                    <TextBlock x:Name="IconText" Text="⬇" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,3" />
                    <TextBlock x:Name="Sub" Foreground="{DynamicResource InfoText}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel x:Name="Buttons" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,12,20,16" />

        <!-- Progress -->
        <StackPanel x:Name="ProgressPanel" DockPanel.Dock="Top" Margin="20,14,20,0">
            <ProgressBar x:Name="ProgressBarControl" Height="8" Minimum="0" Maximum="100" />
            <DockPanel Margin="0,6,0,0">
                <TextBlock x:Name="ProgressRight" DockPanel.Dock="Right" Foreground="{DynamicResource MutedText}" FontSize="12" />
                <TextBlock x:Name="ProgressLeft" Foreground="{DynamicResource MutedText}" FontSize="12" />
            </DockPanel>
        </StackPanel>

        <!-- What's new -->
        <DockPanel x:Name="NotesPanel" Margin="20,16,20,0">
            <TextBlock x:Name="NotesHeading" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Border Background="{DynamicResource NotesBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,4,14,8">
                    <StackPanel x:Name="NotesList" />
                </ScrollViewer>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
