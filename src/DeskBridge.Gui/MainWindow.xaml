<Window x:Class="DeskBridge.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeskBridge.Gui.ViewModels"
        Title="DeskBridge" Width="1180" Height="800" MinWidth="900" MinHeight="600"
        Background="#F5F6F8" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="70" />
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1D4ED8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB" />
            <Setter Property="Background" Value="White" />
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="SelectionMode" Value="Single" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Profile bar -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,10">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Profile" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                <ComboBox x:Name="ProfileCombo" Width="200" ItemsSource="{Binding Model.Profiles}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedProfile}" VerticalContentAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="Name" VerticalAlignment="Center" Margin="4,0,6,0" Foreground="#6B7280" />
                <TextBox Width="150" Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,0,8,0" />
                <Button Content="New" Click="NewProfile_Click" />
                <Button Content="Duplicate" Click="DuplicateProfile_Click" />
                <Button Content="Delete" Click="DeleteProfile_Click" />

                <Button DockPanel.Dock="Right" Content="Apply profile" Style="{StaticResource Primary}" Click="Apply_Click" Margin="0" />
                <Button DockPanel.Dock="Right" Content="Save" Click="Save_Click" />
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding AgentStatus}" Foreground="#6B7280" />
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Margin="10" Padding="10" Background="#F5F6F8">
            <!-- ============ Layout ============ -->
            <TabItem Header="  Layout  ">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="180" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3*" MinHeight="160" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="10">
                        <Canvas x:Name="LayoutCanvas" ClipToBounds="True" SizeChanged="LayoutCanvas_SizeChanged" />
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,10">
                        <ItemsControl ItemsSource="{Binding Summary}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <DataGrid Grid.Row="2" x:Name="AssignmentGrid" ItemsSource="{Binding SelectedProfile.Assignments}"
                              SelectionChanged="AssignmentGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Physical display" Binding="{Binding Display.Id, StringFormat='Display {0}'}" IsReadOnly="True" Width="110" />
                            <DataGridTextColumn Header="Of" Binding="{Binding Owner.Name}" IsReadOnly="True" Width="150" />
                            <DataGridTextColumn Header="Native mode" Binding="{Binding Display.Summary}" IsReadOnly="True" Width="150" />
                            <DataGridTemplateColumn Header="Used by" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.Model.Machines, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding UsedBy, UpdateSourceTrigger=PropertyChanged}" Margin="2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Stream resolution" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" IsEnabled="{Binding IsLent}" Margin="2"
                                                  ItemsSource="{x:Static vm:EditorModel.ResolutionOptions}"
                                                  Text="{Binding Resolution, UpdateSourceTrigger=LostFocus}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Refresh (Hz)" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" IsEnabled="{Binding IsLent}" Margin="2"
                                                  ItemsSource="{x:Static vm:EditorModel.RefreshOptions}"
                                                  Text="{Binding Refresh, UpdateSourceTrigger=LostFocus}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Bitrate (Mbps)" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" IsEnabled="{Binding IsLent}" Margin="2"
                                                  ItemsSource="{x:Static vm:EditorModel.BitrateOptions}"
                                                  Text="{Binding Bitrate, UpdateSourceTrigger=LostFocus}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ============ Machines ============ -->
            <TabItem Header="  Machines  ">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="4*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Machines" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                   Text="The machine with 'Keyboard &amp; mouse' is the coordinator: profiles are edited and applied from it. Leave the port empty to use the default." />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Add machine" Click="AddMachine_Click" />
                            <Button Content="Remove" Click="RemoveMachine_Click" />
                        </StackPanel>
                        <DataGrid x:Name="MachineGrid" ItemsSource="{Binding Model.Machines}" SelectedItem="{Binding SelectedMachine}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id, UpdateSourceTrigger=LostFocus}" Width="100" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="*" />
                                <DataGridTextColumn Header="Address" Binding="{Binding Address, UpdateSourceTrigger=LostFocus}" Width="130" />
                                <DataGridTextColumn Header="Port" Binding="{Binding ControlPort, TargetNullValue=''}" Width="70" />
                                <DataGridCheckBoxColumn Header="Keyboard &amp; mouse" Binding="{Binding HasInput, UpdateSourceTrigger=PropertyChanged}" Width="130" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"
                                   Text="{Binding SelectedMachine, StringFormat='Physical displays of {0}', TargetNullValue='Physical displays'}" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                                   Text="'Detect' reads them from Windows on this PC, or asks the machine's agent over the network. X/Y is the arrangement in Windows display settings." />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Detect" Style="{StaticResource Primary}" Click="DetectDisplays_Click" />
                            <Button Content="Add display" Click="AddDisplay_Click" />
                            <Button Content="Remove" Click="RemoveDisplay_Click" />
                        </StackPanel>
                        <DataGrid x:Name="DisplayGrid" ItemsSource="{Binding SelectedMachine.Displays}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id, UpdateSourceTrigger=LostFocus}" Width="50" />
                                <DataGridTextColumn Header="Width" Binding="{Binding Width}" Width="*" />
                                <DataGridTextColumn Header="Height" Binding="{Binding Height}" Width="*" />
                                <DataGridTextColumn Header="Hz" Binding="{Binding RefreshHz}" Width="50" />
                                <DataGridTextColumn Header="X" Binding="{Binding X}" Width="60" />
                                <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============ This PC ============ -->
            <TabItem Header="  This PC  ">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <GroupBox Header="This machine">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="This PC is" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" IsEditable="True" Margin="0,4" Width="220" HorizontalAlignment="Left"
                                      ItemsSource="{Binding MachineIds}" Text="{Binding LocalMachine, UpdateSourceTrigger=LostFocus}" />

                            <TextBlock Grid.Row="1" Text="Shared key" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" FontFamily="Consolas" VerticalContentAlignment="Center"
                                     Text="{Binding LocalKey, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="8,4,0,4">
                                <Button Content="Generate" Click="GenerateKey_Click" />
                                <Button Content="Copy" Click="CopyKey_Click" Margin="0" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="Control port" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Width="90" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                                     Text="{Binding LocalPort, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource Hint}" Margin="0,6"
                                       Text="Every machine needs the same shared key. On the laptop, pick 'laptop' here, paste the key and save: its agent then waits for the coordinator. The layout is only edited on the coordinator." />

                            <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="Save and restart agent" Style="{StaticResource Primary}" Click="SaveLocal_Click" />
                                <TextBlock Text="{Binding AgentStatus}" VerticalAlignment="Center" Foreground="#6B7280" Margin="6,0" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Header="Log" Margin="0">
                        <ListBox x:Name="LogList" ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="12" BorderThickness="0" />
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
