// Example configuration. The GUI creates and edits %APPDATA%\DeskBridge\deskbridge.json for you.
// Display ids are the numbers Windows shows in Settings > Display > Identify.
// x/y are the display positions as arranged in Windows.
{
  "controlPort": 47900,
  "machines": [
    {
      "id": "desktop",
      "name": "Desktop PC",
      "address": "192.168.1.10",
      "hasInput": true,
      "displays": [
        { "id": "1", "width": 1920, "height": 1080, "refreshHz": 60, "x": 0, "y": 0 },
        { "id": "2", "width": 1920, "height": 1080, "refreshHz": 60, "x": 1920, "y": 0 },
        { "id": "3", "width": 1920, "height": 1080, "refreshHz": 60, "x": 3840, "y": 0 }
      ]
    },
    {
      "id": "laptop",
      "name": "Work laptop",
      "address": "192.168.1.20",
      "displays": [
        { "id": "1", "width": 1920, "height": 1080, "refreshHz": 60 }
      ]
    }
  ],
  "profiles": [
    {
      // Every machine keeps its own displays; only keyboard and mouse are shared.
      "name": "personal",
      "assignments": []
    },
    {
      // The laptop screen becomes the desktop's 4th display.
      "name": "four-screens",
      "assignments": [
        { "machine": "laptop", "display": "1", "usedBy": "desktop" }
      ]
    },
    {
      // The laptop works on desktop displays 2 and 3,
      // and its own screen shows one of the desktop's.
      "name": "work",
      "assignments": [
        { "machine": "desktop", "display": "2", "usedBy": "laptop" },
        { "machine": "desktop", "display": "3", "usedBy": "laptop", "stream": { "bitrateMbps": 30 } },
        { "machine": "laptop", "display": "1", "usedBy": "desktop" }
      ]
    }
  ]
}
